    "nodes": {
        "31fde069": {
            "node_data": {
                "name": "Teleportation Stations",
                "type": "location",
                "description": "Checkpoint stations within the Hospice where workers sign in for their shifts. Features an identification panel where employees confirm their presence and receive work assignments. Workers use these stations to teleport between different areas of the facility."
            },
            "node_id": "31fde069",
            "node_path": null,
            "node_type": "__main__.Custom_Node"
        },
        "cfcf1807": {
            "node_data": {
                "name": "Room 1142",
                "type": "location",
                "description": "A small dorm room on floor 74 of the Hospice with dark wooden paneling. Contains a yellow bucket with cleaning supplies, a faux-mahogany dresser, a cracked leather chair, and a large green mechanical bed. This is where Zania finds the mummified corpse of the previous occupant connected to life support tubes."
            },
            "node_id": "cfcf1807",
            "node_path": null,
            "node_type": "__main__.Custom_Node"
        },
        "5a6b4968": {
            "node_data": {
                "name": "Hallway",
                "type": "location",
                "description": "The corridor outside of Room 1142 on floor 74 where multiple dorm rooms are located. Features a teleport chamber at the end where workers evacuate during emergencies. During the crisis, workers evaporate into wisps of light as they use the teleportation system."
            },
            "node_id": "5a6b4968",
            "node_path": null,
            "node_type": "__main__.Custom_Node"
        },
        "c2004ba6": {
            "node_data": {
                "name": "Central Auditorium",
                "type": "location",
                "description": "A deserted auditorium at the heart of the Hospice serving as the Central Computer Core. Features empty seats arranged in rows and a large cylindrical pedestal at the center decorated with blinking lights, charts, and indicators. The pedestal contains the child-brain AI (Sasha) that controls the entire facility. A green translucent holographic representation of the Hospice can be projected from this location showing all rooms and activity."
            },
            "node_id": "c2004ba6",
            "node_path": null,
            "node_type": "__main__.Custom_Node"
        },
        "ca87e2f2": {
            "node_data": {
                "name": "Central Computer Core",
                "type": "location",
                "description": "A restricted area within the Auditorium where the central processing system of the Hospice is housed. At its center is the cylindrical pedestal containing Sasha, the brain-based AI that manages all facility operations, patient care, and worker assignments."
            },
            "node_id": "ca87e2f2",
            "node_path": null,
            "node_type": "__main__.Custom_Node"
        },
        "9a6d5661": {
            "node_data": {
                "name": "The Soup",
                "type": "location",
                "description": "A mysterious biological processing system or facility within the Hospice where patients and workers who are deemed 'out of place' or undesirable are processed. According to Sasha, elderly patients are kept here in their final days before being converted into a substance used to sustain the brain AI."
            },
            "node_id": "9a6d5661",
            "node_path": null,
            "node_type": "__main__.Custom_Node"
        },
        "797b3c30": {
            "node_data": {
                "name": "Hospice",
                "type": "location",
                "description": "A futuristic medical facility run by Lantern Industries where the elderly and terminally ill are cared for. It features teleportation stations, cleaning services, dorm rooms with patients on mechanical beds with life support tubes, and various corridors. The facility also houses the Central Computer Core in its center."
            },
            "node_id": "797b3c30",
            "node_path": null,
            "node_type": "__main__.Custom_Node"
        },
